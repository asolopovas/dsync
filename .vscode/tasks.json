{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "just: setup",
      "type": "shell",
      "command": "just",
      "args": ["setup"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "just: run",
      "type": "shell",
      "command": "just run ${input:runArgs}",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$go"
    },
    {
      "label": "just: check",
      "type": "shell",
      "command": "just check ${input:checkJobs}",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$go"
    },
    {
      "label": "just: build",
      "type": "shell",
      "command": "just",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$go"
    },
    {
      "label": "just: release",
      "type": "shell",
      "command": "just release ${input:releaseArgs}",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$go"
    }
  ],
  "inputs": [
    {
      "id": "runArgs",
      "type": "promptString",
      "description": "Arguments for dsync (empty for none)",
      "default": "--help"
    },
    {
      "id": "checkJobs",
      "type": "promptString",
      "description": "Optional check jobs: fmt vet test test-race integration-test bench coverage build",
      "default": ""
    },
    {
      "id": "releaseArgs",
      "type": "promptString",
      "description": "Release args (for example: --dry-run, --bump patch --no-push)",
      "default": "--dry-run"
    }
  ]
}
